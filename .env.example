# Supabase Configuration
# Replace these with your Supabase Project URL and Anon Key from your Supabase Dashboard (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL for Dynamic QR Redirects (e.g. https://yourdomain.com or http://localhost:5173 for local dev)
# If left empty, the application will automatically fall back to window.location.origin
VITE_APP_URL=http://localhost:5173
